// Keymap do Zed, portado do Kiro.
// Fonte da verdade: ~/dotfiles/zed/.config/zed/keymap.json
// (linkado em ~/.config/zed/keymap.json pelo home-manager - veja
// ~/nixos/home/modules/dotfiles.nix).
//
// Regras do port:
// - O terminal nunca e afetado: as binds de painel/fluxo levam !Terminal e as de
//   editor usam o contexto Editor (que o terminal nao tem), entao as teclas do
//   shell (ctrl-e, ctrl-l, ctrl-q, ctrl-w, alt-b, ...) continuam indo pro PTY.
// - O Zed TEM chord nativo (o default usa "ctrl-k ctrl-z", "alt-g b") e tem
//   workspace::SendKeystrokes para encadear acoes. Quase nada do Kiro precisou
//   disso: os runCommands do Kiro (ctrl+/ = foco no editor + busca) viram uma
//   acao so no Zed.
// - O Zed nao tem when tao fino quanto o do VS Code; onde importa usamos os
//   contextos reais (GitDiff > Editor, Editor && !agent_diff, not_editing, ...).
// - Os comentarios marcam o default do Zed que cada bind desloca.
[
  // ---- paineis, foco e fluxo ----
  {
    // Historico, fluxo de arquivo/pasta e fechar aba. O contexto "!Terminal" e
    // nao-positivo de proposito: sem identificador positivo o depth_of cai na
    // profundidade maxima da pilha, entao estas 5 vencem os defaults que moram
    // mais fundo (ctrl-o/workspace::OpenFiles e ctrl-q/zed::Quit sao globais;
    // ctrl-i/editor::ShowSignatureHelp e ctrl-shift-o/outline::Toggle sao do
    // Editor). Um contexto que casa no no Workspace - como o bloco logo abaixo -
    // e raso e perde para eles. O !Terminal mantem a regra do arquivo: no
    // terminal o ctrl-q e o ctrl-o seguem indo pro PTY.
    "context": "!Terminal",
    "bindings": {
      "ctrl-o": "pane::GoBack", // era workspace::OpenFiles (abrir arquivo vai pro ctrl-shift-f)
      "ctrl-i": "pane::GoForward", // era editor::ShowSignatureHelp
      "ctrl-q": "pane::CloseActiveItem", // era zed::Quit global (sair do Zed fica no menu / alt+F4). No AgentPanel o bloco de ctrl-q casa no empate e vence por vir depois
      "ctrl-shift-f": "workspace::OpenFiles", // era project_search::ToggleFocus no Pane (que agora e o ctrl-f)
      "ctrl-shift-o": "workspace::Open" // era outline::Toggle no Editor. "Opens a file or directory" (o Kiro usa workbench.action.files.openFolder; nao existe workspace::OpenFolder no Zed). O picker proprio do Zed em vez do dialogo do sistema vem de use_system_path_prompts=false no settings.json
    }
  },
  {
    "context": "Workspace && !Terminal",
    "bindings": {
      "ctrl-e": "project_panel::ToggleFocus", // era file_finder::Toggle (o file finder segue no ctrl-p)
      "ctrl-g": "git_panel::ToggleFocus", // era go_to_line::Toggle (gotoLine vai pro ctrl-;)
      "ctrl-;": "go_to_line::Toggle", // era editor::ToggleLineNumbers
      // era buffer_search::Deploy (busca no arquivo vai pro ctrl-/)
      "ctrl-l": "agent::ToggleFocus", // era editor::SelectLine (o ctrl-? do Zed continua valendo)
      "ctrl-'": "terminal_panel::Toggle", // era editor::ToggleSelectedDiffHunks (o ctrl-` continua valendo)
      "alt-o": "project_symbols::Toggle"
    }
  },
  {
    // O Kiro desliga "novo arquivo sem titulo" (ctrl+n) e "nova janela"
    // (ctrl+shift+n) sem rebindar as duas. Aqui o corte e por acao (unbind), nao
    // por tecla: morrem so workspace::NewFile e workspace::NewWindow, em
    // qualquer profundidade (inclusive o [Welcome]), e o menu::SelectNext
    // global sobrevive - que e o que faz ctrl-n/ctrl-p andarem as listas
    // (pickers, paineis). Um "null" raso nao alcancaria o [Welcome], e um null
    // ou unbind sem contexto tiraria o ctrl-n das listas. As teclas new e
    // shift-new (criar arquivo/janela) seguem valendo.
    "context": "!Terminal",
    "unbind": {
      "ctrl-n": "workspace::NewFile",
      "ctrl-shift-n": "workspace::NewWindow"
    }
  },
  {
    // Com o painel do agente focado. O Kiro faz toggle no ctrl-l (abre/foca e,
    // se ja estiver focado, some com o sidebar); no Zed o agent::ToggleFocus do
    // bloco acima so devolve o foco ao editor, entao aqui o ctrl-l esconde o
    // dock. O painel do agente esta no dock da direita (settings: agent.dock).
    "context": "AgentPanel",
    "bindings": {
      // esconde o sidebar do agente
      "ctrl-q": "workspace::CloseActiveDock" // fecha a sessao (o ctrl-q do bloco acima fecha o item do editor)
    }
  },
  {
    // alt-c leva ao input de commit de qualquer lugar, num toque: o ctrl-g abre/foca
    // o git panel (git_panel::FocusEditor so e tratado com o painel renderizado) e o
    // alt-c seguinte cai no bloco do GitPanel abaixo, que foca o comentario. Se o
    // painel ja esta focado, o contexto mais profundo (GitPanel) vence e vai direto
    // ao input. Abrir/fechar o painel fica so no ctrl-g. O !BufferSearchBar mantem
    // o alt-c da busca alternando case sensitive.
    "context": "Workspace && !Terminal && !BufferSearchBar",
    "bindings": {
      "alt-c": ["workspace::SendKeystrokes", "ctrl-g alt-c"]
    }
  },
  {
    "context": "GitPanel && !BufferSearchBar",
    "bindings": {
      "alt-c": "git_panel::FocusEditor" // no Kiro o alt-c leva direto pro input do commit
    }
  },
  {
    "context": "!Editor && !Terminal",
    "bindings": {
      "ctrl-w": "editor::ToggleFocus" // voltar pro editor quando o foco esta em painel/picker
    }
  },

  // ---- editor: movimento, selecao e clipboard ----
  {
    // !Picker: o input dos pickers tambem e um Editor. Sem isto, os binds deste
    // bloco (e os de busca abaixo) valeriam dentro do quick open e quebrariam a
    // navegacao da lista e a edicao do campo de busca.
    "context": "Editor && !Picker",
    "bindings": {
      "alt-h": "editor::MoveLeft",
      "alt-l": "editor::MoveRight",
      "alt-j": "editor::MoveDown",
      "alt-k": "editor::MoveUp",
      "alt-b": "editor::MoveToPreviousWordStart",
      "alt-e": "editor::MoveToNextWordEnd",
      "alt-[": "editor::MoveToBeginningOfLine",
      "alt-]": "editor::MoveToEndOfLine",
      "shift-alt-h": "editor::SelectLeft",
      "shift-alt-l": "editor::SelectRight",
      "shift-alt-j": "editor::SelectDown",
      "shift-alt-k": "editor::SelectUp",
      "shift-alt-b": "editor::SelectToPreviousWordStart",
      "shift-alt-e": "editor::SelectToNextWordEnd",
      "shift-alt-[": "editor::SelectToBeginningOfLine", // era editor::MoveToStartOfLargerSyntaxNode; no Kiro e selecao ate o inicio da linha
      "shift-alt-]": "editor::SelectToEndOfLine", // era editor::MoveToEndOfLargerSyntaxNode
      "ctrl-d": "editor::MovePageDown", // era editor::SelectNext (que agora e o ctrl-n)
      "ctrl-u": "editor::MovePageUp", // era editor::UndoSelection
      "ctrl-j": "editor::MoveToEnclosingBracket" // era workspace::ToggleBottomDock
    }
  },
  {
    "context": "Editor && !agent_diff",
    "bindings": {
      // Copiar/colar do Kiro. O contexto !agent_diff e o mesmo do default que
      // sai daqui (alt-y = git::StageAndNext); no diff do agente o predicado
      // !agent_diff nao casa, entao o alt-y de la (agent::Keep) continua valendo.
      "alt-y": "editor::Copy", // era git::StageAndNext (o stage segue no alt-s)
      "alt-v": "editor::Paste"
    }
  },

  // ---- editor: busca, ocorrencias, simbolos e git ----
  {
    "context": "Editor && !Picker",
    "bindings": {
      "ctrl-/": "buffer_search::Deploy", // era editor::ToggleComments
      "ctrl-n": ["editor::SelectNext", { "replace_newest": false }], // era editor::MoveDown; no Kiro e a proxima ocorrencia da palavra
      "ctrl-shift-n": "editor::SelectPrevious", // era editor::SelectDown; no Kiro e a ocorrencia anterior
      "ctrl-p": "file_finder::Toggle", // era editor::MoveUp; no Kiro o ctrl-p no editor abre o quick open (Go to File)
      "ctrl-k": "editor::ShowCompletions", // era editor::KillRingCut; no Kiro o ctrl-k abre as recomendacoes do language server. ATENCAO: isto poe uma bind cheia num prefixo de chord do Zed (ctrl-k z soft wrap, ctrl-k q rewrap, ctrl-k p copy path, ctrl-k r reveal, ctrl-k e/t/u fechar abas) - se os chords pararem de responder, troque por "ctrl-space": "editor::ShowCompletions" (default do Zed) e devolva o ctrl-k
      "ctrl-r": "git::OpenFileDiff", // era projects::OpenRecent; no Kiro o ctrl-r abre o diff do arquivo atual
      "ctrl-w": "outline::Toggle", // no Zed 1.17 nao existe mais picker de simbolos do arquivo: e o painel Outline
      "alt-n": "editor::GoToNextChange",
      "alt-p": "editor::GoToPreviousChange",
      "alt-d": "editor::GoToImplementation",
      "alt-u": "editor::FindAllReferences",
      "alt-s": "git::ToggleStaged",
      "alt-x": "editor::RevertSelectedHunks"
    }
  },
  {
    "context": "Editor && !Picker && !BufferSearchBar",
    "bindings": {
      "alt-w": "outline::Toggle" // dentro da busca o alt-w continua alternando whole word
    }
  },
  {
    "context": "GitDiff > Editor",
    "bindings": {
      // No Kiro o ctrl-n/ctrl-p no diff pula de mudanca em mudanca; no editor
      // normal as mesmas teclas andam pelas ocorrencias da palavra.
      "ctrl-n": "editor::GoToHunk",
      "ctrl-p": "editor::GoToPreviousHunk"
    }
  },

  // ---- barra de busca ----
  {
    "context": "BufferSearchBar",
    "bindings": {
      "ctrl-c": "buffer_search::Dismiss", // era menu::SelectNext; no Kiro ctrl-n/ctrl-p andam pelos resultados
      "ctrl-p": "search::SelectPreviousMatch",
      "ctrl-shift-n": "search::SelectPreviousMatch"
    }
  },
  {
    // No input da busca, o no Editor do proprio input fica mais fundo que o
    // [BufferSearchBar]/[ProjectSearchBar], e tanto o [Editor && !Picker]
    // (ctrl-p = file_finder) quanto o global menu::SelectPrevious casam na
    // profundidade maxima - por isso os binds do bloco acima nao disparavam no
    // campo de busca. O contexto (barra > editor) casa na profundidade maxima.
    // SelectPrevious/NextMatch e a mesma acao do shift-enter/enter na barra.
    "context": "BufferSearchBar > Editor",
    "bindings": {
      "ctrl-p": "search::SelectPreviousMatch",
      "ctrl-n": "search::SelectNextMatch"
    }
  },
  {
    "context": "ProjectSearchBar > Editor",
    "bindings": {
      "ctrl-p": "search::SelectPreviousMatch",
      "ctrl-n": "search::SelectNextMatch"
    }
  },

  // ---- listas: alt-j/alt-k descem e sobem (list.focusDown/Up do Kiro) ----
  {
    // So `Picker` (e nao `Picker || menu`): com a lista de completions aberta o
    // alt-j/alt-k precisa continuar movendo o cursor, nao a lista.
    "context": "Picker",
    "bindings": {
      "alt-j": "menu::SelectNext", // quick open, command palette, pickers de simbolo
      "alt-k": "menu::SelectPrevious",
      "ctrl-c": "menu::Cancel" // o default so vale quando o foco esta na lista; no input do picker a secao Editor do Zed poe editor::Copy ali
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "alt-j": "menu::SelectNext",
      "alt-k": "menu::SelectPrevious"
    }
  },
  {
    // ctrl-n/ctrl-p/ctrl-shift-n/alt-j/alt-k andam a lista de alteracoes. A
    // reafirmacao de ctrl-n/ctrl-p/ctrl-shift-n e redundante (o default global
    // menu::SelectNext/Previous casa aqui na mesma profundidade e estas vem
    // depois), mas fica: e a pista de que a lista anda por essas teclas.
    // menu::SelectNext/Previous movem so a selecao, como o alt-j/alt-k.
    "context": "GitPanel && ChangesList && !GitBranchSelector && !GitRepositorySelector",
    "bindings": {
      "ctrl-n": "menu::SelectNext",
      "ctrl-p": "menu::SelectPrevious",
      "ctrl-shift-n": "menu::SelectPrevious",
      "alt-j": "menu::SelectNext",
      "alt-k": "menu::SelectPrevious"
    }
  },
  {
    "context": "OutlinePanel && not_editing",
    "bindings": {
      "alt-j": "menu::SelectNext",
      "alt-k": "menu::SelectPrevious"
    }
  },
  {
    "context": "ProjectSearchView",
    "bindings": {
      "alt-j": "menu::SelectNext", // resultados do ctrl-f
      "alt-k": "menu::SelectPrevious"
    }
  },
  {
    "context": "ThreadsSidebar && !Editor",
    "bindings": {
      "alt-j": "menu::SelectNext", // lista de conversas do painel do agente
      "alt-k": "menu::SelectPrevious"
    }
  }

  // ---- sem equivalente no Zed (sem bind) ----
  //   ctrl+y, ctrl+k ctrl+k -> kiro.views.specExplorer.focus (spec explorer do Kiro)
  //   ctrl+shift+e          -> lafco.epicsQuickOpen (extensao propria do Kiro)
  //   alt+x na busca        -> search.action.remove (o Zed nao remove resultado focado)
  //   ctrl+c no multibuffer -> closeReferenceSearch (no Zed o ctrl-c ali copia; use escape)
,
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-shift-f": "pane::DeploySearch"
    }
  },
  {
    "context": "Pane",
    "unbind": {
      "ctrl-shift-f": "project_search::ToggleFocus"
    }
  },
  {
    "context": "ProjectSearchBar",
    "unbind": {
      "ctrl-shift-f": "search::FocusSearch"
    }
  },
  {
    "context": "AcpThread",
    "unbind": {
      "ctrl-f": "agent::ToggleSearch"
    }
  },
  {
    "context": "AcpThread > Editor",
    "unbind": {
      "ctrl-f": "agent::ToggleSearch"
    }
  },
  {
    "context": "AgentPanel > Terminal",
    "unbind": {
      "ctrl-f": "agent::ToggleSearch"
    }
  },
  {
    "context": "ThreadsSidebar",
    "unbind": {
      "ctrl-f": "agents_sidebar::FocusSidebarFilter"
    }
  },
  {
    "context": "Editor && mode == full",
    "unbind": {
      "ctrl-f": "buffer_search::Deploy"
    }
  },
  {
    "context": "MarkdownPreview",
    "unbind": {
      "ctrl-f": "buffer_search::Deploy"
    }
  },
  {
    "context": "BufferSearchBar",
    "unbind": {
      "ctrl-f": "search::FocusSearch"
    }
  },
  {
    "context": "AcpThreadSearchBar",
    "unbind": {
      "ctrl-f": "search::FocusSearch"
    }
  },
  {
    "context": "KeymapEditor",
    "unbind": {
      "ctrl-f": "search::FocusSearch"
    }
  },
  {
    "context": "SettingsWindow",
    "unbind": {
      "ctrl-f": "search::FocusSearch"
    }
  },
  {
    // Sem contexto = profundidade maxima: vence os defaults e os unbinds da
    // outra sessao por vir depois deles. A acao e pane::DeploySearch (a mesma do
    // ctrl-shift-f default): project_search::ToggleFocus so alterna o foco entre
    // o campo e os resultados e nao faz nada quando a busca ainda nao existe -
    // era esse o motivo de "ctrl-f nao abrir a busca global". Nota: DeploySearch
    // semeia a query com a selecao/palavra sob o cursor, como o ctrl-shift-f.
    "bindings": {
      "ctrl-f": "pane::DeploySearch"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-/": [
        "editor::ToggleComments",
        {
          "advance_downwards": false
        }
      ]
    }
  },
  {
    "context": "!Picker && ProjectSearchBar",
    "bindings": {
      "ctrl-c": "buffer_search::Dismiss"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-l": "editor::SelectLine"
    }
  },
  {
    "context": "AcpThread",
    "bindings": {
      "ctrl-l": "workspace::ToggleRightDock"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-alt-b": "workspace::ToggleRightDock"
    }
  },
  {
    "context": "BufferSearchBar",
    "bindings": {
      "ctrl-/": "buffer_search::Dismiss"
    }
  },
  {
    "context": "AgentPanel",
    "unbind": {
      "ctrl-n": "agent::NewThread"
    }
  },
  {
    "context": "AcpThread",
    "unbind": {
      "ctrl-n": "agent::NewThread"
    }
  },
  {
    "context": "AgentPanel > Terminal",
    "unbind": {
      "ctrl-n": "agent::NewThread"
    }
  },
  {
    "context": "ThreadsSidebar",
    "unbind": {
      "ctrl-n": "agents_sidebar::NewThreadInGroup"
    }
  },
  {
    "context": "Editor && (showing_code_actions || showing_completions)",
    "unbind": {
      "ctrl-n": "editor::ContextMenuNext"
    }
  },
  {
    "context": "ProjectPanel",
    "unbind": {
      "ctrl-n": "project_panel::NewFile"
    }
  },
  {
    "context": "BufferSearchBar",
    "bindings": {
      "ctrl-n": "search::SelectNextMatch"
    }
  },
  {
    "context": "AcpThreadSearchBar",
    "bindings": {
      "ctrl-p": "agent::SelectPreviousThreadMatch"
    }
  },
  {
    "context": "AcpThreadSearchBar > Editor",
    "bindings": {
      "ctrl-p": "agent::SelectPreviousThreadMatch"
    }
  }
]
