// keymap.json — zed-101-setup (jellydn) mesclado com os keymaps do nvim
// Fonte nvim: lua/keymaps.lua + config/lsp.lua, telescope.lua, git.lua, format.lua, debug.lua
// Prioridade: binds do nvim > extras do zed-101. fff-gpui continua comentado.
// Obs: gco/gcO (comentar linha acima/abaixo) e <leader>r (registers) não têm
// equivalente no Zed — ficam de fora.
[
	{
		// Normal & Visual — nvim (keymaps.lua + LSP Attach) + zed-101
		"context": "Editor && (vim_mode == normal || vim_mode == visual) && !VimWaiting && !menu",
		"bindings": {
			// ── Git (zed-101) ──────────────────────────────────────────────
			"space g s": "git_panel::ToggleFocus",
			// ── Markdown (zed-101) ─────────────────────────────────────────
			"space m p": "markdown::OpenPreview",
			"space m P": "markdown::OpenPreviewToTheSide",
			// ── Zen / layout centralizado (zed-101) ────────────────────────
			"space c z": "workspace::ToggleCenteredLayout",
			// ── Busca (zed-101 + nvim <leader>/) ───────────────────────────
			"space s w": "pane::DeploySearch",
			"space s b": "buffer_search::Deploy",
			"space /": "buffer_search::Deploy", // nvim <leader>/ = grep em buffers abertos
			// ── AI inline (zed-101) ───────────────────────────────────────
			"space a i": "assistant::InlineAssist",
			// ── Painel do agente (zed-101) ─────────────────────────────────
			"space a c": "agent::ToggleFocus",
			"space a n": "agent::NewThread",
			"space a m": "agent::ToggleModelSelector",
			"space a s": "agent::OpenSettings",
			"space a a": "agent::OpenProjectAGENTS.mdRules",
			"space a d": "agent::OpenAgentDiff",
			// ── Comentários (nvim gcc treesitter / gc visual) ─────────────
			"g c": "editor::ToggleComments",
			// ── Abrir arquivo sob o cursor (nvim go = gf nativo) ───────────
			"g o": "editor::OpenExcerpts"
		}
	},
	{
		// Somente modo normal
		"context": "Editor && vim_mode == normal && !VimWaiting && !menu",
		"bindings": {
			// ── Janelas (nvim: <C-hjkl> = <C-w>hjkl) ───────────────────────
			"ctrl-h": "workspace::ActivatePaneLeft",
			"ctrl-l": "workspace::ActivatePaneRight",
			"ctrl-k": "workspace::ActivatePaneUp",
			"ctrl-j": "workspace::ActivatePaneDown",
			// ── Splits (nvim: <C-w>v / <C-w>b) ─────────────────────────────
			"ctrl-w v": "pane::SplitRight",
			"ctrl-w b": "pane::SplitDown",
			// ── Resize janelas (nvim: <C-setas>) ───────────────────────────
			"ctrl-up": "vim::ResizePaneUp",
			"ctrl-down": "vim::ResizePaneDown",
			"ctrl-left": "vim::ResizePaneLeft",
			"ctrl-right": "vim::ResizePaneRight",
			// Resize alternativo (zed-101)
			"ctrl-shift-k": "vim::ResizePaneUp",
			"ctrl-shift-j": "vim::ResizePaneDown",
			"ctrl-shift-h": "vim::ResizePaneLeft",
			"ctrl-shift-l": "vim::ResizePaneRight",
			// ── Mover linhas (nvim: mini.move <M-hjkl>) ────────────────────
			"alt-j": "editor::MoveLineDown",
			"alt-k": "editor::MoveLineUp",
			"alt-l": "editor::Indent",   // mini.move line_right
			"alt-h": "editor::Outdent",  // mini.move line_left
			// ── Buffers (nvim: <C-x>/<C-q> fecha, [b/]b navega) ────────────
			"ctrl-x": "pane::CloseActiveItem",
			"ctrl-q": "pane::CloseActiveItem",
			"shift-q": "pane::CloseActiveItem",
			"[b": "pane::ActivatePreviousItem",
			"]b": "pane::ActivateNextItem",
			"space b n": "workspace::NewFile",    // nvim <leader>bn
			"space b d": "pane::CloseActiveItem", // nvim <leader>bd
			"space b b": "pane::ActivatePreviousItem", // <C-^> (alterna último buffer)
			"space b o": "pane::CloseOtherItems", // zed-101
			// ── Fuzzy finder (nvim: telescope <leader>f*) ──────────────────
			"space space": "file_finder::Toggle",
			"space f f": "file_finder::Toggle",  // <leader>ff find files
			"space f g": "pane::DeploySearch",   // <leader>fg live grep
			"space f w": "pane::DeploySearch",   // <leader>fw palavra sob cursor
			"space f b": "tab_switcher::Toggle", // <leader>fb buffers
			"space f n": "workspace::NewFile",   // zed-101
			"space f p": "projects::OpenRecent", // zed-101 (nvim abre ~/prdbook/staging — ver tasks.json)
			// ── Explorador (nvim: <leader>e mini.files) ────────────────────
			"space e": "project_panel::ToggleFocus",
			// ── Formatar (nvim: <leader>c conform) ─────────────────────────
			// "space c" dispara após o timeout do which-key (há binds c f/r/a abaixo)
			"space c": "editor::Format",
			"space c f": "editor::Format",        // zed-101
			"space c r": "editor::Rename",        // zed-101
			"space c a": "editor::ToggleCodeActions", // zed-101
			// ── LSP (nvim: LspAttach — gd/gD/gi/gr/gt/gf/gp/gR/ga/K) ───────
			"shift-k": "editor::Hover",
			"g d": "editor::GoToDefinition",
			"g D": "editor::GoToDeclaration", // nvim gD = declaração
			"g i": "editor::GoToImplementation",
			"g I": "editor::GoToImplementationSplit", // zed-101
			"g t": "editor::GoToTypeDefinition",
			"g T": "editor::GoToTypeDefinitionSplit", // zed-101
			"g r": "editor::FindAllReferences",
			"g R": "editor::Rename",
			"g a": "editor::ToggleCodeActions",
			// ── Símbolos (nvim: gs/gw telescope) ────────────────────────────
			"g f": "outline_panel::ToggleFocus",  // nvim gf/gs = símbolos do documento
			"g s": "outline_panel::ToggleFocus",
			"g p": "project_symbols::Toggle",     // nvim gp/gw = símbolos do workspace
			"g w": "project_symbols::Toggle",
			// ── Diagnósticos (nvim: ]d/[d) ──────────────────────────────────
			"] d": "editor::GoToDiagnostic",
			"[ d": "editor::GoToPreviousDiagnostic",
			// Só erros/avisos (zed-101)
			"] e": ["editor::GoToDiagnostic", { "severity": "error" }],
			"[ e": ["editor::GoToPreviousDiagnostic", { "severity": "error" }],
			"] w": ["editor::GoToDiagnostic", { "severity": "warning" }],
			"[ w": ["editor::GoToPreviousDiagnostic", { "severity": "warning" }],
			"space l": "diagnostics::Deploy", // nvim <leader>l = diagnóstico da linha
			"space q": "diagnostics::Deploy", // nvim <leader>q = lista quickfix
			// ── Git hunks (nvim: gitsigns ]c/[c) ────────────────────────────
			"] c": "editor::GoToHunk",
			"[ c": "editor::GoToPreviousHunk",
			"] h": "editor::GoToHunk",             // aliases zed-101
			"[ h": "editor::GoToPreviousHunk",
			// ── Git (nvim: <leader>gg neogit / <leader>gb split) ───────────
			"space g g": "workspace::NewTerminal",    // nvim neogit → rodar lazygit no terminal
			"space g b": "git_panel::ToggleFocus",    // nvim neogit vsplit ≈ painel git (dock direito)
			"space g d": "git::Diff",                 // zed-101
			"space g h d": "editor::ToggleSelectedDiffHunks", // zed-101
			"space g h e": "editor::ExpandAllDiffHunks",      // zed-101
			// ── Toggles (nvim: grupo <leader>t) ────────────────────────────
			"space t h": "editor::ToggleInlayHints",      // nvim <leader>th
			"space t b": "editor::ToggleGitBlameInline",  // nvim <leader>tb (gitsigns)
			"space t i": "editor::ToggleHunkDiff",        // nvim <leader>ti (diff inline do hunk)
			"space t t": "terminal_panel::Toggle",        // terminal toggle
			"space u w": "editor::ToggleSoftWrap",        // zed-101
			"space u t": "theme_selector::Toggle",        // trocar tema (como :colorscheme)
			// ── Debug (nvim: nvim-dap <C-1..4> + <leader>dt) ──────────────
			"ctrl-1": "debugger::Start",      // nvim <C-1> = continue (inicia/continua)
			"ctrl-2": "debugger::StepOver",
			"ctrl-3": "debugger::StepInto",
			"ctrl-4": "debugger::StepOut",
			"space d t": "editor::ToggleBreakpoint", // nvim <leader>dt
			// ── Janelas / sessão (zed-101) ─────────────────────────────────
			"space w w": "workspace::ActivatePreviousPane",
			"space w -": "pane::SplitDown",
			"space w |": "pane::SplitRight",
			"space w d": "pane::CloseActiveItem",
			// Salvar (nvim: <C-s>)
			"ctrl-s": "workspace::Save"
		}
	},
	// Empty pane (zed-101)
	{
		"context": "EmptyPane || SharedScreen",
		"bindings": {
			"space space": "file_finder::Toggle",
			"space f p": "projects::OpenRecent",
			"space a c": "agent::ToggleFocus",
			// FFF GUI — descomente após instalar o fff-gpui:
			// "space f f": ["task::Spawn", { "task_name": "fff-gpui: Files" }],
			// "space f g": ["task::Spawn", { "task_name": "fff-gpui: Grep" }],
			"space g s": "git_panel::ToggleFocus"
		}
	},
	// Modo visual — assists inline com a seleção (zed-101)
	{
		"context": "Editor && vim_mode == visual && !VimWaiting && !menu",
		"bindings": {
			"space a e": ["assistant::InlineAssist", { "prompt": "Explain the selected code. Cover purpose, control flow, and non-obvious behavior." }],
			"space a f": ["assistant::InlineAssist", { "prompt": "Fix bugs and issues in the selected code. Identify root causes, not just symptoms." }],
			"space a t": ["assistant::InlineAssist", { "prompt": "Generate focused unit tests for the selected code. Use the project's test framework and conventions. Output with arrange/act/assert sections." }],
			"space a r": ["assistant::InlineAssist", { "prompt": "Refactor the selected code for clarity and maintainability without changing external behavior. Extract functions, simplify conditions, remove duplication." }],
			"space a d": ["assistant::InlineAssist", { "prompt": "Add concise inline documentation comments to the selected code without changing logic." }],
			"space a k": ["assistant::InlineAssist", { "prompt": "Summarize the selected code. One-paragraph summary plus key takeaways." }],
			"space a n": "agent::NewThread",
			"space a v": ["action::Sequence", ["agent::ToggleFocus", "agent::AddSelectionToThread"]]
		}
	},
	// Escapes no insert mode (zed-101)
	{
		"context": "Editor && vim_mode == insert && !menu",
		"bindings": {
			"j j": "vim::NormalBefore",
			"j k": "vim::NormalBefore"
		}
	},
	// Operador c do vim → cr (rename) e ca (code actions) (zed-101)
	{
		"context": "Editor && vim_operator == c",
		"bindings": {
			"c": "vim::CurrentLine",
			"r": "editor::Rename",
			"a": "editor::ToggleCodeActions"
		}
	},
	// Terminal toggle (zed-101)
	{
		"context": "Workspace",
		"bindings": {
			"ctrl-\\": "terminal_panel::ToggleFocus",
			// VSCode-like: Linux usa ctrl-b (no macOS era cmd-b)
			"ctrl-b": "workspace::ToggleRightDock"
		}
	},
	{
		"context": "Terminal",
		"bindings": {
			"ctrl-h": "workspace::ActivatePaneLeft",
			"ctrl-l": "workspace::ActivatePaneRight",
			"ctrl-k": "workspace::ActivatePaneUp",
			"ctrl-j": "workspace::ActivatePaneDown"
		}
	},
	// Painel de arquivos estilo netrw (zed-101)
	{
		"context": "ProjectPanel && not_editing",
		"bindings": {
			"a": "project_panel::NewFile",
			"A": "project_panel::NewDirectory",
			"r": "project_panel::Rename",
			"d": "project_panel::Delete",
			"x": "project_panel::Cut",
			"c": "project_panel::Copy",
			"p": "project_panel::Paste",
			"q": "workspace::ToggleRightDock",
			"space e": "workspace::ToggleRightDock",
			"ctrl-h": "workspace::ActivatePaneLeft",
			"ctrl-l": "workspace::ActivatePaneRight",
			"ctrl-k": "workspace::ActivatePaneUp",
			"ctrl-j": "workspace::ActivatePaneDown"
		}
	},
	// Navegação entre painéis (zed-101)
	{
		"context": "Dock",
		"bindings": {
			"ctrl-w h": "workspace::ActivatePaneLeft",
			"ctrl-w l": "workspace::ActivatePaneRight",
			"ctrl-w k": "workspace::ActivatePaneUp",
			"ctrl-w j": "workspace::ActivatePaneDown"
		}
	},
	// Rodar task mais próxima (zed-101)
	{
		"context": "EmptyPane || SharedScreen || vim_mode == normal",
		"bindings": {
			"space r t": ["editor::SpawnNearestTask", { "reveal": "no_focus" }]
		}
	},
	// Which key — desabilita o default do space no modo vim (zed-101)
	{
		"context": "(VimControl && !menu)",
		"bindings": {
			"space": null,
			// FFF GUI — descomente após instalar o fff-gpui:
			// "space f f": ["task::Spawn", { "task_name": "fff-gpui: Files" }],
			// "space f g": ["task::Spawn", { "task_name": "fff-gpui: Grep" }]
		}
	}
]
