layout {
    // Tab 1: compose — 2x2 grid de terminais em ~/ahg/compose
    tab name="compose" {
        pane {
            pane command="bash" cwd="/home/vinicius.falconi@sp01.local/ahg/compose"
            pane command="bash" cwd="/home/vinicius.falconi@sp01.local/ahg/compose"
        }
        pane {
            pane command="bash" cwd="/home/vinicius.falconi@sp01.local/ahg/compose"
            pane command="bash" cwd="/home/vinicius.falconi@sp01.local/ahg/compose"
        }
    }
    // Tab 2: nvim (60%) + pi (40%) em ~/prdbook
    tab {
        pane size="60%" {
            command "nvim"
            cwd "/home/vinicius.falconi@sp01.local/prdbook"
        }
        pane size="40%" {
            command "pi"
            cwd "/home/vinicius.falconi@sp01.local/prdbook"
        }
    }
}
