# bash functions

# ── Development utilities ─────────────────────────────────────────────────────

# mkcd: create a directory and immediately cd into it
mkcd() {
    mkdir -p "$1" && cd "$1"
}

# up: go N directories up  (up 3 == cd ../../..)
up() {
    local d=""
    local limit="${1:-1}"
    for ((i=1; i<=limit; i++)); do
        d="../$d"
    done
    cd "${d:-.}" || return 1
}

# extract: unpack any archive format
extract() {
    if [[ -f "$1" ]]; then
        case "$1" in
            *.tar.bz2)  tar xjf "$1"     ;;
            *.tar.gz)   tar xzf "$1"     ;;
            *.tar.xz)   tar xJf "$1"     ;;
            *.tar.zst)  tar --zstd -xf "$1" ;;
            *.bz2)      bunzip2 "$1"     ;;
            *.gz)       gunzip "$1"      ;;
            *.tar)      tar xf "$1"      ;;
            *.tbz2)     tar xjf "$1"     ;;
            *.tgz)      tar xzf "$1"     ;;
            *.zip)      unzip "$1"       ;;
            *.Z)        uncompress "$1"  ;;
            *.7z)       7z x "$1"        ;;
            *.rar)      unrar x "$1"     ;;
            *)          echo "'$1' cannot be extracted via extract()" ;;
        esac
    else
        echo "'$1' is not a valid file"
    fi
}

# fcd: fuzzy-find and cd into a directory under current path
fcd() {
    local dir
    dir=$(fd --type d --hidden --follow --exclude .git 2>/dev/null | \
          fzf --preview 'eza --tree --level=2 {} 2>/dev/null || ls {}') && \
    cd "$dir"
}

# fopen: fuzzy-find a file and open it in $EDITOR
fopen() {
    local file
    file=$(fd --type f --hidden --follow --exclude .git 2>/dev/null | \
           fzf --preview 'bat --color=always --line-range=:50 {}') && \
    ${EDITOR:-nvim} "$file"
}

# port: show what's listening on a given port
port() {
    lsof -i :"${1:-80}"
}

# json: pretty-print JSON from stdin or file
json() {
    if [[ -n "$1" ]]; then
        jq '.' "$1"
    else
        jq '.'
    fi
}

# ── Git helpers ───────────────────────────────────────────────────────────────

# gclean: remove merged local branches
gclean() {
    git branch --merged main 2>/dev/null | grep -v '^\*\|main\|master' | \
        xargs -r git branch -d
}

# groot: cd to the root of the current git repository
groot() {
    local root
    root=$(git rev-parse --show-toplevel 2>/dev/null) && cd "$root" || \
        echo "Not in a git repository"
}

# ── WSL / Windows navigation ───────────────────────────────────────────────────

# Detect if running in WSL (vs Git Bash / MSYS2)
_is_wsl_env() {
    if grep -qi "microsoft\|wsl" /proc/version 2>/dev/null; then
        return 0
    fi
    return 1
}

# Get Windows home path for current user
_winhome() {
    local win_home

    # Try to get Windows home from PowerShell
    win_home=$(powershell.exe -NoProfile -Command '[Environment]::GetFolderPath("UserProfile")' 2>/dev/null | tr -d '\r')

    if [[ -z "$win_home" ]]; then
        echo "/mnt/c/Users/$USER"
        return
    fi

    # Convert to Unix path depending on environment
    if _is_wsl_env; then
        # WSL: use wslpath to convert Windows path to WSL path
        if command -v wslpath &>/dev/null; then
            wslpath "$win_home" 2>/dev/null || echo "$win_home"
        else
            echo "$win_home"
        fi
    else
        # Git Bash / MSYS2: C:\Users\vn -> /c/Users/vn
        echo "$win_home" | sed 's/\\/\//g' | sed 's/^\([A-Za-z]\):/\/\L\1/'
    fi
}

# cdw: cd to Windows home folder
cdw() {
    local target
    target=$(_winhome)
    if [[ -d "$target" ]]; then
        cd "$target" || return 1
    else
        echo "cdw: Windows home not found at $target"
        return 1
    fi
}

# cdwd: cd to Windows desktop
cdwd() {
    local win_home target
    win_home=$(_winhome)
    target="${win_home}/Desktop"
    if [[ -d "$target" ]]; then
        cd "$target" || return 1
    else
        echo "cdwd: Windows Desktop not found"
        return 1
    fi
}

# cdot: cd to dotfiles folder (tries common locations)
cdot() {
    local targets=("/c/dotfiles" "/mnt/c/dotfiles" "$(_winhome)/dotfiles")

    for target in "${targets[@]}"; do
        if [[ -d "$target" ]]; then
            cd "$target" || return 1
            return 0
        fi
    done

    echo "cddd: dotfiles not found (checked: ${targets[*]})"
    return 1
}

# wopen: open current directory or file in Windows File Explorer
wopen() {
    local target="${1:-.}"

    if ! command -v explorer.exe &>/dev/null; then
        echo "wopen: File Explorer not available (not on Windows?)"
        return 1
    fi

    # Get absolute path and convert to Windows path via PowerShell
    local abs_path win_path
    abs_path=$(cd "$target" 2>/dev/null && pwd)
    if [[ -z "$abs_path" ]]; then
        echo "wopen: Cannot resolve path '$target'"
        return 1
    fi

    win_path=$(powershell.exe -NoProfile -Command "[Convert]::ToString((Resolve-Path -LiteralPath '$abs_path').Path)" 2>/dev/null | tr -d '\r')
    if [[ -n "$win_path" ]]; then
        explorer.exe "$win_path"
    else
        echo "wopen: Could not convert path '$abs_path'"
        return 1
    fi
}
