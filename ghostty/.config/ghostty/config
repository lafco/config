# Ghostty — terminal alternativo (no NixOS o principal é o herdr-app).
# Distribuído por symlink (home/modules/dotfiles.nix no nixos repo) e pelo
# `dot stow` nas máquinas sem Nix.
#
# Três escolhas que valem registro:
#   - Wayland nativo, sem os workarounds de enable_wayland / prefer_egl /
#     max_fps que outros terminais pedem (o fps vem do vsync).
#   - enable_kitty_keyboard não existe: no ghostty o protocolo de teclado é
#     fixo (não há opção). Se o herdr tratar Esc como "lone escape", resolver
#     com keybind em vez de config.
#   - hide_tab_bar_if_only_one_tab: o default do ghostty
#     (window-show-tab-bar = auto) já só mostra a barra com mais de uma aba.

# Fonte. O ghostty usa o fallback do fontconfig, mas a lista explícita mantém
# CJK/emoji/nerd glyphs na ordem certa — repetir `font-family` acrescenta
# fallback.
font-family = JetBrains Mono
font-family = Noto Sans CJK SC
font-family = Noto Color Emoji
font-family = Symbols Nerd Font Mono
font-size = 10
# 10% a mais na altura da célula.
adjust-cell-height = 10%

# Cores: tema embutido do ghostty.
theme = Catppuccin Mocha

# Aparência: sem decoração de janela (o GNOME desenha o resto), padding de 5px
# balanceado e cursor sem piscar.
cursor-style-blink = false
window-decoration = none
window-padding-x = 5
window-padding-y = 5
window-padding-balance = true

# Shell: `bash` é resolvido pelo PATH (que inclui /run/current-system/sw/bin) e
# o -l mantém o encadeamento .bash_profile -> .bashrc dos dotfiles. A shell
# integration do ghostty (shell-integration = detect, default) continua
# funcionando: ela detecta pelo nome do processo.
command = bash -l
